CLIENT_URLS=http://localhost:5173,https://full-stack-authentication-applicati.vercel.app
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Recommended on Render free tier (HTTPS email delivery)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=AuthFlow <noreply@your-verified-domain.com>

# SMTP fallback for local development or paid hosting
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
